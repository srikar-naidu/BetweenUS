{
  "name": "between-us",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <22 || >=22.12.0 <23 || >=23.2.0"
  },
  "scripts": {
    "dev": "node --require ./scripts/node-dns-bootstrap.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/node-dns-bootstrap.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/node-dns-bootstrap.cjs ./node_modules/next/dist/bin/next start",
    "worker": "node --require ./scripts/node-dns-bootstrap.cjs --import tsx ./src/temporal/worker.ts",
    "evaluate:phase7": "tsx experiments/phase7/run.ts",
    "evaluate:phase9": "tsx experiments/phase9/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "@sentry/node": "^11.4.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "better-auth": "^1.3.0",
    "ffmpeg-static": "^5.3.0",
    "mongodb": "^7.0.0",
    "next": "^16.3.8",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
