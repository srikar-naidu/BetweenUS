MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=between_us
BETTER_AUTH_SECRET=
# Use the exact browser origin, including hostname (for local dev, open http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIGER_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
GEMMA_RUNTIME=local
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_TIMEOUT_MS=300000

# Optional Backboard group memory (disabled until an owner/admin opts in)
BACKBOARD_API_KEY=
BACKBOARD_API_BASE_URL=https://app.backboard.io/api
BACKBOARD_TIMEOUT_MS=30000

# Optional voice-note transcription. Requires verified provider terms and an approved usage cap.
ELEVENLABS_TRANSCRIPTION_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT_MS=60000
ELEVENLABS_MONTHLY_SECONDS=0
ELEVENLABS_MONTHLY_REQUESTS=0

# Temporal TypeScript processing worker
# Local Temporal: localhost:7233/default with TLS=false. Temporal Cloud requires its endpoint,
# fully qualified namespace, namespace API key, and TLS=true. Configure on both web and worker.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
TEMPORAL_TASK_QUEUE=between-us-processing

# Privacy-minimized Sentry; keep disabled until the project, retention, and privacy settings are approved.
SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=