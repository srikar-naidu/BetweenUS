MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=between_us
BETTER_AUTH_SECRET=
# Use the exact browser origin, including hostname (for local dev, open http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIGER_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
GEMMA_RUNTIME=local
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_TIMEOUT_MS=300000

# Group memory is powered by Backboard after an owner/admin enables it and members share approved corrections.
BACKBOARD_API_KEY=
BACKBOARD_API_BASE_URL=https://app.backboard.io/api
BACKBOARD_TIMEOUT_MS=30000

# Consent-gated ElevenLabs voice transcription.
ELEVENLABS_TRANSCRIPTION_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT_MS=60000
ELEVENLABS_MONTHLY_SECONDS=3600
ELEVENLABS_MONTHLY_REQUESTS=60
ELEVENLABS_STORY_AUDIO_ENABLED=true
ELEVENLABS_STORY_AUDIO_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STORY_AUDIO_MONTHLY_LIMIT=10
ELEVENLABS_STORY_AUDIO_TIMEOUT_MS=180000

# Privacy-minimized Sentry; both DSNs are required to activate the respective server/browser SDKs.
SENTRY_ENABLED=true
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_DSN=